# Copy to .env and fill in your keys. .env is gitignored.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...
# Used by the backend when running outside Docker; compose overrides the host to "db".
# Host port is 5433 to avoid clashing with a locally installed Postgres.
DATABASE_URL=postgresql+asyncpg://rumbo:rumbo@localhost:5433/rumbo
